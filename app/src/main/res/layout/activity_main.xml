<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- شاشة العرض -->
    <EditText
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:textSize="40sp"
        android:textColor="#00ff00"
        android:background="#0f0f23"
        android:gravity="end"
        android:padding="16dp"
        android:inputType="number"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- الصف الأول: Clear, Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:text="AC"
            android:textSize="20sp"
            android:backgroundTint="#e94560" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:text="⌫"
            android:textSize="20sp"
            android:backgroundTint="#e94560" />

        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:text="÷"
            android:textSize="24sp"
            android:backgroundTint="#533483" />
    </LinearLayout>

    <!-- الصف الثاني: 7, 8, 9, × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="7" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="8" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="9" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="×" android:textSize="24sp"
            android:backgroundTint="#533483"/>
    </LinearLayout>

    <!-- الصف الثالث: 4, 5, 6, - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="4" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="5" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="6" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="-" android:textSize="24sp"
            android:backgroundTint="#533483"/>
    </LinearLayout>

    <!-- الصف الرابع: 1, 2, 3, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="1" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="2" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="3" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="+" android:textSize="24sp"
            android:backgroundTint="#533483"/>
    </LinearLayout>

    <!-- الصف الخامس: 0, ., = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="2" android:text="0" android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="." android:textSize="22sp"
            android:backgroundTint="#16213e" android:textColor="#fff"/>
        <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="70dp"
            android:layout_weight="1" android:text="=" android:textSize="24sp"
            android:backgroundTint="#0f3460" android:textColor="#00ff00"/>
    </LinearLayout>

</LinearLayout>
